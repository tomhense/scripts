#!/usr/bin/env python3
import argparse
import subprocess
import sys
from pathlib import Path


def check_file(file_path):
	command = ["ffmpeg", "-v", "error", "-i", str(file_path), "-f", "null", "-"]

	process = subprocess.Popen(
		command,
		stdout=subprocess.DEVNULL,
		stderr=subprocess.PIPE,
		text=True,
		encoding='utf-8',
		errors='ignore'
	)

	has_error = False
	for line in process.stderr:
		if line.strip():
			has_error = True
			process.kill()
			break

	process.wait()

	if has_error or process.returncode != 0:
		return False
	return True


def main():
	parser = argparse.ArgumentParser(description="Check media files with ffmpeg.")
	parser.add_argument("files", nargs="+", help="Files to check")
	args = parser.parse_args()

	files = [Path(f) for f in args.files]

	failed_count = 0

	for file in files:
		if not file.exists():
			print(f"❌ {file} (file not found)", file=sys.stderr)
			failed_count += 1
			continue

		if check_file(file):
			print(f"✅ {file}", file=sys.stdout)
		else:
			print(f"❌ {file}", file=sys.stderr)
			failed_count += 1

	if failed_count > 0:
		sys.exit(1)


if __name__ == "__main__":
	main()